function Resolve-KeyVaultReference {
    param(
        [string]$VaultName,
        [string]$KeyName,
        [string]$KeyId
    )

    $resolvedVaultName = Normalize-OptionalString $VaultName
    $resolvedKeyName = Normalize-OptionalString $KeyName
    $resolvedKeyId = Normalize-OptionalString $KeyId

